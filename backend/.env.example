# AI 学习助手 - 环境变量模板
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会入库）
#   Linux/macOS :  cp backend/.env.example backend/.env
#   Windows     :  copy backend\.env.example backend\.env
#
# 注意：所有相对路径都相对 **backend/ 目录** 解析，与你在哪个目录启动无关。
#       也就是说 ./uploads 指的是 backend/uploads，./study_assistant.db 指的是
#       backend/study_assistant.db。留空则使用同样的默认值。

# AI API 配置（支持任何 OpenAI 兼容接口）
# 也可以完全不在这里配置，改为启动后在网页左下角 [AI 设置] 里填写，
# 那种方式会把 Key 加密保存到 backend/ai_config.json。
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 单次 AI 请求超时（秒）。不设超时的话，上游挂死会让进度条永远停在动画态。
AI_TIMEOUT_SECONDS=120

# 数据库配置（相对路径按 backend/ 解析）
DATABASE_URL=sqlite:///./study_assistant.db

# 上传配置
UPLOAD_DIR=./uploads

# 上传大小上限（MB）。注意：当前版本尚未在代码中强制该限制，属已知待办。
MAX_UPLOAD_SIZE_MB=50
